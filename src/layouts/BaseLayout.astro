---
import "@fontsource-variable/geist";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

// Preload de la fuente principal (solo latin) para mejorar el LCP tipográfico
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

import { profile } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alejandro Duran — Full-Stack Software Engineer",
  description = "Portafolio de desarrollo de software full-stack: arquitectura limpia, interfaces reactivas y APIs tipadas. Disponible para incorporación inmediata.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og.png", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: Astro.site?.href,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location.city,
  },
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-emblem.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f1b2f" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Preload de fuentes (solo latin) -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="relative min-h-screen overflow-x-hidden bg-zinc-950 text-zinc-300 antialiased">
    <!-- Enlace de salto para navegación por teclado (visible solo con foco) -->
    <a
      href="#main-content"
      class="sr-only rounded-lg bg-accent-500 px-4 py-2.5 font-medium text-zinc-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-100 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
    >
      Saltar al contenido
    </a>

    <!-- Fondo técnico: rejilla sutil + grano + resplandor teal -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-tech-grid"></div>
      <div class="absolute inset-0 bg-noise opacity-[0.05]"></div>
      <div class="absolute inset-0 bg-vignette"></div>
      <div
        class="absolute -top-40 left-1/2 h-[32rem] w-[56rem] -translate-x-1/2 rounded-full bg-accent-600/20 blur-[140px]">
      </div>
    </div>
    <slot />

    <!-- Glow teal que sigue al puntero en las tarjetas (solo puntero fino) -->
    <script>
      const hasFinePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)"
      ).matches;

      if (hasFinePointer) {
        document.querySelectorAll<HTMLElement>("[data-glow]").forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            const bounds = card.getBoundingClientRect();
            card.style.setProperty("--glow-x", `${event.clientX - bounds.left}px`);
            card.style.setProperty("--glow-y", `${event.clientY - bounds.top}px`);
          });
        });
      }
    </script>
  </body>
</html>
