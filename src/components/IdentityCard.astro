---
import { Github, Linkedin, ArrowUpRight, Download, Mail } from "lucide-astro";
import Card from "./Card.astro";
import StatusDot from "./StatusDot.astro";
import CopyEmailButton from "./CopyEmailButton.astro";
import { profile } from "../data/portfolio";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const socialLinks = [
  { href: profile.links.github, label: "GitHub", icon: Github },
  { href: profile.links.linkedin, label: "LinkedIn", icon: Linkedin },
];
---

<Card
  as="section"
  class:list={["card-hero md:col-span-2 md:row-span-2 lg:col-span-3", className]}
  labelledby="identity-title"
>
  <!-- Cabecera de la card: estado del perfil -->
  <div class="flex items-start">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-950/70 px-3 py-1">
      <StatusDot />
      <span class="label-mono tracking-tight text-zinc-400">
        {profile.status}
      </span>
    </p>
  </div>

  <!-- Bloque editorial: nombre/rol/pitch a la izquierda, emblema centrado en el espacio libre -->
  <div class="flex flex-1 flex-col items-center justify-between gap-8 py-8 md:flex-row md:gap-12">
    <div class="min-w-0 flex-1">
      <h1
        id="identity-title"
        class="text-4xl font-semibold tracking-[-0.03em] text-zinc-100 md:text-5xl xl:text-6xl"
      >
        {profile.name}
      </h1>
      <p class="mt-2 font-mono text-sm text-accent-400 md:text-base">
        <span aria-hidden="true" class="text-accent-500">// </span>{profile.role}
      </p>

      <p class="mt-6 max-w-lg text-balance text-sm leading-relaxed text-zinc-400 md:text-base">
        {profile.pitch}
      </p>
    </div>

    <img
      src="/logo-emblem.png"
      alt=""
      width="494"
      height="493"
      loading="lazy"
      decoding="async"
      class="h-24 w-auto shrink-0 md:mr-auto md:h-48 md:-translate-x-2 lg:h-60 lg:-translate-x-4"
    />
  </div>

  <!-- Action bar: todas las vías de contacto en una sola tira -->
  <div
    class="flex flex-wrap items-center gap-2 border-t border-zinc-800/80 pt-4"
    role="group"
    aria-label="Acciones de contacto"
  >
    <a
      href={`mailto:${profile.email}`}
      class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1.5 font-mono text-sm text-accent-400 transition-colors duration-200 hover:text-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/70 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
      aria-label={`Enviar un email a ${profile.email}`}
    >
      <Mail class="h-4 w-4" aria-hidden="true" />
      {profile.email}
    </a>

    <CopyEmailButton email={profile.email} compact />

    <div class="ml-auto flex flex-wrap items-center gap-2">
      <a
        href={profile.cvUrl}
        download
        class="btn btn-sm btn-ghost"
        aria-label="Descargar CV en PDF de Alejandro Duran"
      >
        <Download class="h-4 w-4" aria-hidden="true" />
        <span class="hidden items-center gap-1 sm:inline-flex">
          CV
          <span class="label-mono">PDF</span>
        </span>
      </a>

      <nav
        aria-label="Enlaces sociales"
        class="flex flex-wrap gap-2"
      >
        {
          socialLinks.map(({ href, label, icon: Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-ghost group font-mono text-xs"
              aria-label={`${label} de ${profile.name} (abre en una pestaña nueva)`}
            >
              <Icon class="h-4 w-4" aria-hidden="true" />
              <span class="hidden sm:inline">{label}</span>
              <ArrowUpRight
                class="hidden h-3 w-3 text-zinc-500 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent-400 sm:block"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</Card>
