---
import { Github, Linkedin, ArrowUpRight, Download, Mail } from "lucide-astro";
import Card from "./Card.astro";
import StatusDot from "./StatusDot.astro";
import CopyEmailButton from "./CopyEmailButton.astro";
import { profile } from "../data/portfolio";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const socialLinks = [
  { href: profile.links.github, label: "GitHub", icon: Github },
  { href: profile.links.linkedin, label: "LinkedIn", icon: Linkedin },
];
---

<Card
  as="section"
  class:list={["card-hero md:col-span-2 md:row-span-2 lg:col-span-3", className]}
  labelledby="identity-title"
>
  <!-- Badge de estado activo -->
  <p
    class="inline-flex items-center gap-2 self-start rounded-full border border-zinc-800 bg-zinc-950/70 px-3 py-1">
    <StatusDot />
    <span class="font-mono text-[11px] tracking-tight text-zinc-400">
      {profile.status}
    </span>
  </p>

  <!-- Bloque editorial: nombre + slot tipo medallón -->
  <div class="flex flex-1 items-center gap-6 py-8">
    <div class="min-w-0 flex-1">
      <h1
        id="identity-title"
        class="text-4xl font-semibold tracking-[-0.03em] text-bone-100 md:text-5xl xl:text-6xl"
      >
        {profile.name}
      </h1>
      <p class="mt-2 font-mono text-sm text-accent-400 md:text-base">
        <span aria-hidden="true" class="text-accent-500">// </span>{profile.role}
      </p>

      <p class="mt-6 max-w-lg text-balance text-sm leading-relaxed text-zinc-400 md:text-base">
        {profile.pitch}
      </p>
    </div>

    <!-- Slot de foto: medallón con anillo dorado (placeholder hasta poner foto/memoji) -->
    <div class="flex shrink-0 items-center justify-center lg:flex-1">
      <div class="relative">
        <span
          aria-hidden="true"
          class="absolute -inset-1 rounded-full border border-gold-500/30"
        >
        </span>
        <img
          src="/avatar.png"
          alt=""
          width="160"
          height="160"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          class="h-24 w-24 rounded-full object-cover ring-2 ring-gold-500/40 shadow-[0_0_50px_-8px_rgb(201_151_63_/_0.35)] md:h-32 md:w-32 xl:h-40 xl:w-40"
        />
      </div>
    </div>
  </div>

  <!-- Action bar: todas las vías de contacto en una sola tira -->
  <div
    class="flex flex-wrap items-center gap-2 border-t border-zinc-800/80 pt-4"
    role="group"
    aria-label="Acciones de contacto"
  >
    <a
      href={`mailto:${profile.email}`}
      class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1.5 font-mono text-sm text-accent-400 transition-colors duration-200 hover:text-bone-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/70 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950"
      aria-label={`Enviar un email a ${profile.email}`}
    >
      <Mail class="h-4 w-4" aria-hidden="true" />
      {profile.email}
    </a>

    <CopyEmailButton email={profile.email} compact />

    <a
      href={profile.cvUrl}
      download
      class="btn btn-sm btn-ghost"
      aria-label="Descargar CV en PDF de Alejandro Duran"
    >
      <Download class="h-4 w-4" aria-hidden="true" />
      CV
      <span class="font-mono text-[11px]">PDF</span>
    </a>

    <nav
      aria-label="Enlaces sociales"
      class="ml-auto flex flex-wrap gap-2"
    >
      {
        socialLinks.map(({ href, label, icon: Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-ghost group font-mono text-xs"
            aria-label={`${label} de ${profile.name} (abre en una pestaña nueva)`}
          >
            <Icon class="h-4 w-4" aria-hidden="true" />
            <span>{label}</span>
            <ArrowUpRight
              class="h-3 w-3 text-zinc-500 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent-400"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>
  </div>
</Card>
