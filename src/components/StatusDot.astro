---
/**
 * Punto de estado pulsante (verde). Evita duplicar el patrón de spans
 * reutilizables en las tarjetas del bento.
 */
interface Props {
  size?: "sm" | "md";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;
const dotClass = size === "sm" ? "h-1.5 w-1.5" : "h-2 w-2";
---

<span class:list={["relative flex", dotClass, className]} aria-hidden="true">
  <span
    class:list={[
      "absolute inline-flex h-full w-full animate-status-pulse rounded-full bg-green-500",
    ]}
  >
  </span>
  <span
    class:list={["relative inline-flex rounded-full bg-green-500", dotClass]}
  >
  </span>
</span>
